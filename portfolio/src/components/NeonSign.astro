---
import { Image } from 'astro:assets';
import base from '../assets/neon/base.svg';
import lit from '../assets/neon/lit.svg';

---


<h1 class = "neon-sign">
    <Image src = {lit} alt = "" class = "glow"/>
    <Image src = {base} alt = "Emil Brunsnes" class = "base" />
    <Image src ={lit} alt = "" class = "lit"/>
</h1>


<style>
    .neon-sign {
        position: relative;
        margin: 0;
        max-width: 900px;
    }

    .neon-sign :global(.glow){
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        filter: blur(20px) saturate(1.6);
        opacity: calc(var(--lit) * 0.9);
    }

    .neon-sign :global(.base){
        display: block;
        width: 100%;
        height: auto;
        filter: drop-shadow(4px 8px 10px rgba(0, 0, 0, 0.5));
    }

    .neon-sign :global(.lit){
        position: absolute;
        inset: 0;
        width: 100%;
        height: auto;
        filter:
        drop-shadow(0 0 4px #ff3fa4)
        drop-shadow(0 0 14px #ff3fa4);
    }

    .neon-sign::before {
        content: '';
        position: absolute;
        inset: -40% -25%;
        background: radial-gradient(closest-side, rgba(255, 63, 164, 0.3), transparent);
        mix-blend-mode: screen;
        pointer-events: none;
        z-index: -1;
        translate: -12% 5%;
    }

    .neon-sign :global(.lit),
    .neon-sign::before {
        opacity: var(--lit);
    }

  
</style>