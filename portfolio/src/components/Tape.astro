---
import { Image } from 'astro:assets';

const tapes = Object.values(
    import.meta.glob('../assets/tape/*.{png,webp,jpg}', { eager: true, import: 'default' })
)

const {
  top = '-14px',
  left = '50%',
  bottom,
  width = 100,
  rotate,        // leave out for a random angle
  variant,       // leave out for a random tape image
} = Astro.props;

const src = variant !== undefined
  ? tapes[variant % tapes.length]
  : tapes[Math.floor(Math.random() * tapes.length)];

const angle = rotate ?? Math.random() * 16 - 8;   // random between -8° and 8°
const vertical = bottom !== undefined ? `bottom: ${bottom};` : `top: ${top ?? '-14px'};`;
---

<Image
  src={src}
  alt=""
  class="tape"
  style={`${vertical} left: ${left}; width: ${width}px; --rot: ${angle}deg;`}
/>

<style>
    :global(.tape){
        position: absolute;
        height: auto;
        transform: translateX(-50%) rotate(var(--rot));
        pointer-events: none;
        z-index: 5;
        filter: saturate(0.9) brightness(0.95);
        opacity: 0.5;
    }
</style>