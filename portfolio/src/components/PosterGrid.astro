---
import { Image } from 'astro:assets';
import shadow from '../assets/posters/shadow-synth.jpg';
import guitar from '../assets/posters/guitar-trainer.jpg';
import rc from '../assets/posters/rc-car.jpg';
import canvas from '../assets/posters/canvas.jpg';
import Tape from './Tape.astro';

const posters = [
  {href: '/shadow-synth', img: shadow, alt: 'View Shadow Synth', rotate: -1, scale: 1.05, tape: 'diag'},
  {href: '/canvas', img: canvas, alt: 'View the Canvas', rotate: 1.2, scale: 1, tape: 'corners'},
  {href: '/guitar-trainer', img: guitar, alt: 'View guitar trainer', rotate: -0.3, scale: 0.95, tape: 'diag'},
  {href: '/rc-car', img: rc, alt: 'View RC car', rotate: 0.6, scale: 0.93, tape: 'top'},
];
---

<main class="poster-grid">
  {posters.map((p) => (
    <a class="poster" href={p.href} style={`--rot: ${p.rotate}deg; --scale: ${p.scale};`}>
      <Image src={p.img} alt={p.alt} />
      
      {p.tape === 'top' && (
        <Tape top="-14px" left="50%" width={110} />
      )}

      {p.tape === 'corners' && (
        <>
          <Tape top="-8px" left="4%"  width={80} rotate={-35} />
          <Tape top="-8px" left="96%" width={80} rotate={35} />
        </>
      )}

      {p.tape === 'diag' && (
        <>
          <Tape top="-8px" left="4%"  width={80} rotate={-35} />
          <Tape bottom="-8px" left="96%" width={80} rotate={-35} />
        </>
      )}

    </a>
  ))}
</main>

<style>
  .poster-grid {
    display: grid;
    grid-template-columns: 1fr;
    flex: 1;
    margin: 0;
    gap: 2rem;
    padding: 1.5rem 2rem 4rem 2rem;
  }

  @media (min-width: 640px) {
    .poster-grid {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 1.5rem;
      row-gap: 1rem;
    }
  }

  .poster {
    position: relative;
    display: block;
    transform: rotate(var(--rot)) scale(var(--scale));

    box-shadow: var(--shadow-near), var(--shadow-far);
    transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1), 
                box-shadow 0.25s cubic-bezier(0.2, 0.8, 0.2, 1),
                z-index 0s;
  }

  .poster:hover {
    transform: rotate(0) scale(calc(var(--scale) * 1.03)) translateY(-6px);
    z-index: 15;
    box-shadow: 
      0 4px 8px rgba(0, 0, 0, 0.15),
      0 16px 32px rgba(0, 0, 0, 0.3),
      0 28px 50px rgba(0, 0, 0, 0.35);
  }

  .poster :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
