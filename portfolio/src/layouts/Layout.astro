---
interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Emil Brunsnes", 
  description = "Design engineering student at Imperial College London" 
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  body {
    background-color: #b5a585;               /* shows while the image loads */
    background-image:
      radial-gradient(ellipse at center, transparent 35%, rgba(0,0,0,.65) 100%),
      linear-gradient(rgba(20,10,5,.25), rgba(20,10,5,.25)),
      url("/brick.webp");

    background-size: cover, auto, 512px;
    background-repeat: no-repeat, no-repeat, repeat;
    background-attachment: fixed, scroll, scroll;
    background-blend-mode: normal, normal, multiply;
}
</style>
