---
interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Emil Brunsnes", 
  description = "Design engineering student at Imperial College London" 
} = Astro.props;

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <slot />
    <div class="shade" aria-hidden="true"></div>
    <div class="light" aria-hidden="true"></div>
    <div class="grain" aria-hidden="true"></div>
  </body>
</html>

<style is:global>
  body {
    background-color: #6e3528;               /* shows while the image loads */
    background-image:
      linear-gradient(rgba(20,10,5,.25), rgba(20,10,5,.25)),
      url("/brick.webp");
    background-size: auto, 512px;
    background-repeat:  no-repeat, repeat;
    background-attachment:  scroll, scroll;
    background-blend-mode:  normal, multiply;
}

  :root {
    --light-x: 25vw;
    --light-y: 15vh;
    --shadow-near: 3px 4px 4px rgba(0, 0, 0, 0.35);    /* tight contact shadow */
    --shadow-far: 10px 16px 24px rgba(0, 0, 0, 0.4);   /* soft, further out */
    --neon-on: 2.4s;
    --neon-cycle: 7s;
  }

  body {
    margin: 0;
    position: relative;     /* overlays are positioned against the page */
    min-height: 100vh;
  }

    .shade,
  .light {
    position: absolute;
    inset: 0;
    pointer-events: none;     /* clicks pass through */
    z-index: 100;             /* above everything, so posters get lit too */
  }

  /* Darkness away from the bulb */
  .shade {
    background: radial-gradient(
      ellipse 110vw 130vh at var(--light-x) var(--light-y),
      transparent 35%,
      rgba(15, 8, 3, 0.6) 100%
    );
  }

  /* Warm glow near the bulb */
  .light {
    animation:
      switchOn var(--neon-on) steps(1, end) both,
      stutter var(--neon-cycle) steps(1, end) var(--neon-on) infinite;
    background: radial-gradient(
      ellipse 60vw 60vh at var(--light-x) var(--light-y),
      rgba(255, 120, 180, 0.35),
      transparent 70%
    );
    mix-blend-mode: soft-light;   /* warms and brightens without washing out */
  }

  .grain {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 101;
    opacity: 0.12;
    mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
  }

  @keyframes switchOn {
    0%        { opacity: 0; }
    4%        { opacity: 0.6; }   /* first spark */
    6%        { opacity: 0; }
    14%       { opacity: 1; }     /* almost catches... */
    16%       { opacity: 0.1; }
    20%       { opacity: 0; }     /* ...and drops out */
    34%       { opacity: 0.8; }
    37%       { opacity: 0.2; }
    40%       { opacity: 1; }
    44%       { opacity: 0.3; }   /* one last wobble */
    52%, 100% { opacity: 1; }     /* on for good */
  }

/* Running: a small dip, then a noticeable burst near the end of each cycle */
  @keyframes stutter {
    0%, 40%           { opacity: 1; }
    40.5%             { opacity: 0.5; }   /* quick dip */
    41.5%             { opacity: 1; }

    85%               { opacity: 0.1; }   /* burst starts */
    85.6%             { opacity: 1; }
    86.3%             { opacity: 0.05; }
    87%               { opacity: 0.7; }
    87.5%             { opacity: 0.1; }
    88.5%, 100%       { opacity: 1; }     /* recovers */
  }

  @media (prefers-reduced-motion: reduce) {
    .light { animation: none; }
  }
</style>
