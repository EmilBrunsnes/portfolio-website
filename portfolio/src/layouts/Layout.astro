---
interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Emil Brunsnes — Design Engineer", 
  description = "Design engineering student at Imperial College London" 
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  body {
    margin: 0;
    min-height: 100vh;
    background-color: #8f8f8b;
    font-family: 'Courier New', Courier, monospace;
  }
</style>
