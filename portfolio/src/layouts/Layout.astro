---
interface Props {
  title?: string;
  description?: string;
  venue?: boolean;
}

const { title = "Emil Brunsnes", description = "Design engineering student at Imperial College London", venue = true } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class:list={[{ venue }]}>
    <slot />
    {venue && (
      <>
        <div class="shade" aria-hidden="true"></div>
        <div class="light" aria-hidden="true"></div>
        <div class="black" aria-hidden="true"></div>
        <div class="corner-light" aria-hidden="true"></div>
      </>
    )}
    <div class="grain" aria-hidden="true"></div>
  </body>
</html>

<style is:global>
  body {
    background-color: #6e3528;               /* shows while the image loads */
    background-image:
      linear-gradient(rgba(20,10,5,.25), rgba(20,10,5,.25)),
      url("/brick.webp");
    background-size: auto, 512px;
    background-repeat:  no-repeat, repeat;
    background-attachment:  scroll, scroll;
    background-blend-mode:  normal, multiply;
}

  :root {
    --light-x: 25vw;
    --light-y: 15vh;
    --shadow-near: 3px 4px 4px rgba(0, 0, 0, 0.35);    /* tight contact shadow */
    --shadow-far: 10px 16px 24px rgba(0, 0, 0, 0.4);   /* soft, further out */
    --neon-on: 2.4s;
    --neon-cycle: 12s;
    --neon-delay: 0.5s;
  }

  body.venue {
    margin: 0;
    position: relative;     /* overlays are positioned against the page */
    min-height: 100vh;
    animation:
    switchOn var(--neon-on) steps(1, end) var(--neon-delay) both,
    stutter var(--neon-cycle) steps(1, end) calc(var(--neon-delay) + var(--neon-on)) infinite;
  }

    .shade,
  .light {
    position: absolute;
    inset: 0;
    pointer-events: none;     /* clicks pass through */
    z-index: 100;             /* above everything, so posters get lit too */
  }

  /* Darkness away from the bulb */
  .shade {
    background: radial-gradient(
      ellipse 110vw 130vh at var(--light-x) var(--light-y),
      transparent 35%,
      rgba(15, 8, 3, 0.6) 100%
    );
  }

  /* Warm glow near the bulb */
  .light {
    opacity: var(--lit);
    background: radial-gradient(
      ellipse 60vw 60vh at var(--light-x) var(--light-y),
      rgba(255, 120, 180, 0.35),
      transparent 70%
    );
    mix-blend-mode: soft-light;   /* warms and brightens without washing out */
  }

  .corner-light {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 100;
    background: radial-gradient(
    ellipse 150vw 150vh at 100% 100%,
    rgb(255, 236, 215),
    transparent 100%
  );
    mix-blend-mode: soft-light;
  }

  .grain {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 101;
    opacity: 0.12;
    mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
  }

  .black {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 100;
    background: rgb(5, 3, 2);
    opacity: calc((1 - var(--lit)) * 0.9); /* 90% off when screen off*/
  }

  @property --lit {
    syntax: '<number>';
    inherits: true;
    initial-value: 0;
  }

  @keyframes switchOn {
    0%        { --lit: 0; }
    4%        { --lit: 0.6; }   /* first spark */
    6%        { --lit: 0; }
    14%       { --lit: 1; }     /* almost catches... */
    16%       { --lit: 0.1; }
    20%       { --lit: 0; }     /* ...and drops out */
    34%       { --lit: 0.8; }
    37%       { --lit: 0.2; }
    40%       { --lit: 1; }
    44%       { --lit: 0.3; }   /* one last wobble */
    52%, 100% { --lit: 1; }     /* on for good */
  }

/* Running: a small dip, then a noticeable burst near the end of each cycle */
  @keyframes stutter {
    0%, 40%           { --lit: 1; }
    40.5%             { --lit: 0.9; }   /* quick dip */
    41.5%             { --lit: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    body {
    animation: none;
    --lit: 1;
  }
  }
</style>
