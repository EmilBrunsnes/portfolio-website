---
import Layout from './Layout.astro';
import { Image } from 'astro:assets';
const { project, prev, next } = Astro.props;
const p = project.data;

import '@fontsource/archivo-black';
import '@fontsource/archivo';
---

<Layout title={`${p.title} — Emil Brunsnes`} venue={false}>
  <article class="feature">
    <header class="opener">
      <Image src={p.cover} alt={p.title} class="cover" />
      <div>
        <h1>{p.title}</h1>
        <p class="tagline">{p.tagline}</p>
        {p.highlight && <p class="highlight">{p.highlight}</p>}
      </div>
    </header>

    <div class="body">
      <slot />   <!-- the project's written content goes here -->
    </div>

    <footer class="credits">
      <p><strong>Role:</strong> {p.role}</p>
      {p.team && <p><strong>Team:</strong> {p.team}</p>}
      {p.duration && <p><strong>Duration:</strong> {p.duration}</p>}
      <p><strong>Tools:</strong> {p.tools.join(' · ')}</p>
    </footer>

    <nav class="page-turn">
      <a href={`/${prev.id}`}>← {prev.data.title}</a>
      <a href="/">back to the wall</a>
      <a href={`/${next.id}`}>{next.data.title} →</a>
    </nav>
  </article>
</Layout>

<style>

    .feature {
    font-family: 'Archivo', serif;
    }

    .opener h1,
    .body :global(h2) {
    font-family: 'Archivo Black', serif;
    }

  /* The magazine page, laid on the wall */
  .feature {
    max-width: 960px;
    margin: 3rem auto;
    padding: clamp(1.5rem, 4vw, 4rem);
    background: #f4f1e8 url("/paper.webp");
    background-size: 400px;
    background-blend-mode: multiply;
    color: #1a1a1a;
    filter: drop-shadow(var(--shadow-near)) drop-shadow(var(--shadow-far));
  }

  /* Opening spread: cover on the left, title on the right */
  .opener {
    display: grid;
    grid-template-columns: minmax(200px, 320px) 1fr;
    gap: 2.5rem;
    align-items: end;
  }

  .opener :global(.cover) {
    width: 100%;
    height: auto;
    transform: rotate(-2deg);
    filter: drop-shadow(3px 6px 10px rgba(0, 0, 0, 0.35));
  }

  .opener h1 {
    margin: 0 0 0.5rem;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .tagline {
    margin: 0 0 1rem;
    font-size: 1.15rem;
  }

  /* Hype sticker */
  .highlight {
    display: inline-block;
    margin: 0;
    padding: 0.4rem 0.9rem;
    background: #5fc8ea;
    font-family: 'Permanent Marker', cursive;
    transform: rotate(-3deg);
  }

  /* The article. :global because the MDX content isn't part of this component */
  .body {
    margin-top: 3rem;
    line-height: 1.6;
  }

  /* Text stays a readable width... */
  .body :global(p),
  .body :global(h2),
  .body :global(h3),
  .body :global(ul),
  .body :global(ol) {
    max-width: 65ch;
  }

  .body :global(h2) {
    margin: 2.5rem 0 0.75rem;
    font-size: 1.1rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  /* ...but images and videos go full width, for an image-heavy layout */
  .body :global(figure) {
    margin: 2.5rem 0;
  }

  .body :global(figure img),
  .body :global(figure video) {
    display: block;
    width: 100%;
    height: auto;
  }

  .body :global(figcaption) {
    margin-top: 0.5rem;
    font-family: 'Permanent Marker', cursive;
    font-size: 0.95rem;
  }

  /* Credits */
  .credits {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 2px dashed #8a8a8a;
    font-size: 0.9rem;
  }

  .credits p {
    margin: 0.25rem 0;
  }

  /* Previous / back / next */
  .page-turn {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2.5rem;
  }

  .page-turn a {
    color: inherit;
  }

  /* Phones: stack the cover above the title */
  @media (max-width: 700px) {
    .opener {
      grid-template-columns: 1fr;
    }

    .opener :global(.cover) {
      max-width: 260px;
    }

    .page-turn {
      flex-direction: column;
      align-items: center;
    }
  }
</style>